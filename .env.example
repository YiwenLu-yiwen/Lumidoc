##################################################
# Lumidoc平台 - 环境配置文件示例
# 创建实际使用的.env文件时请复制此文件并适当修改配置
##################################################

# 基础环境设置
# 环境类型: local, production
ENVIRONMENT=local
DEBUG_MODE=true
LOG_LEVEL=info
# LOG_FILE已移除 - 各服务使用自己的默认日志路径
PROJECT_NAME=Lumidoc Web UI

##################################################
# 微服务端口配置
# 所有服务URL将基于这些端口生成
##################################################

# 前端与服务端口
BIND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
PROJECT_SERVICE_PORT=8020
CHAT_SERVICE_PORT=8001
QUESTION_SERVICE_PORT=8002
GRAPH_SERVICE_PORT=8003
FILE_SERVICE_PORT=8004
FILEPROC_SERVICE_PORT=8005
RAG_SERVICE_PORT=8006
AUTH_SERVICE_PORT=8007
MONITORING_SERVICE_PORT=8008
LLM_SERVICE_PORT=8080
LLM_SUMMARY_SERVICE_PORT=8009


##################################################
# 微服务URL配置
##################################################

# 服务基础域名，本地开发为 localhost，生产环境可设为实际域名
SERVICE_HOST=localhost
# 生产环境示例: SERVICE_HOST=lumidoc-service 或域名

# 前端URL配置 - 在跨服务通信中使用
FRONTEND_URL=http://localhost:3000
# 生产环境示例: FRONTEND_URL=https://lumidoc.example.com

# 各服务URL配置 - 直接配置完整URL便于前端解析
CHAT_SERVICE_URL=http://localhost:8001
QUESTION_SERVICE_URL=http://localhost:8002
GRAPH_SERVICE_URL=http://localhost:8003
FILE_SERVICE_URL=http://localhost:8004
FILEPROC_SERVICE_URL=http://localhost:8005
RAG_SERVICE_URL=http://localhost:8006
AUTH_SERVICE_URL=http://localhost:8007
MONITORING_SERVICE_URL=http://localhost:8008
LLM_SERVICE_URL=http://localhost:8080
LLM_SUMMARY_SERVICE_URL=http://localhost:8009
PROJECT_SERVICE_URL=http://localhost:8020

##################################################
# 数据库配置
##################################################

# PostgreSQL配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=lumidoc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# PostgreSQL映射到宿主机的端口（用于规避5432冲突）
POSTGRES_HOST_PORT=5432
POSTGRES_URL=postgresql://postgres:change-me-postgres@localhost:5432/lumidoc

# Neo4j配置
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_URI=bolt://localhost:7687

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-redis

##################################################
# 存储模式配置
##################################################

# 存储类型: POSTGRES, SQLITE, MONGO, NEO4J
AUTH_STORAGE_MODE=POSTGRES
QUESTION_STORAGE_MODE=POSTGRES
CHAT_STORAGE_MODE=POSTGRES
GRAPH_STORAGE_MODE=NEO4J

# 文件存储类型: local, s3
STORAGE_TYPE=s3

##################################################
# 文件存储与处理配置
##################################################

# 文件存储路径
CONTENT_DIR=./content
MODELS_DIR=./models
UPLOAD_DIR=./uploads
RAPIDOCR_MODELS_PATH=./src/models/RapidOCR

# 本地存储配置
AUTH_LOCAL_STORAGE_DIR=data/auth
LIGHTRAG_LOCAL_STORAGE_DIR=data/lightrag
PROJECT_LOCAL_STORAGE_DIR=data/projects
QUESTION_LOCAL_STORAGE_DIR=data/questions

# 文件处理通用配置
MAX_FILE_SIZE=10485760
CLEAN_UNUSED_FILES=true
INSTANCE_ID=file_service_1
SAVE_ORIGINAL_FILES=false
FILE_PROCESSING_QUEUE=file_processing
FILE_PROCESSING_WORKERS=2

# 文件处理器配置
ENABLE_OCR=false
USE_GPU=false

##################################################
# S3/MinIO存储配置
##################################################

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio
S3_BUCKET=data
S3_REGION=us-east-1

##################################################
# LLM & Embedding 配置
##################################################

# Docker 内置 Ollama 模型配置（由 ollama_models 服务自动拉取）
LLM_MODEL_TYPE=ollama
OLLAMA_CHAT_MODEL=qwen3:1.7b
# 默认自动选择 GPU，无法使用时回退 CPU；--native / --gpu / --cpu 可强制指定
# NATIVE_OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_KEEP_ALIVE=15m
CHAT_RETRIEVAL_TIMEOUT=8
CHAT_MAX_TOKENS=512
# 思考模式需要为模型推理和正文共同预留输出预算
CHAT_THINKING_MAX_TOKENS=2048
LLM_MODEL_NAME=qwen3:1.7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_REQUEST_TIMEOUT=300

# Embedding配置
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIM=768
EMBEDDING_DIM=768

# LLM核心服务配置
DEFAULT_LLM_MODEL=qwen3:1.7b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
MODEL_CACHE_TTL=3600
MAX_CACHED_MODELS=3
MAX_TOKENS_PER_REQUEST=4096
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.95
DEFAULT_TOP_K=40
REQUEST_TIMEOUT=60

# LLM摘要配置
SUMMARY_MAX_LENGTH=1000
ENABLE_STRUCTURED_OUTPUT=true
ENABLE_CACHE=true
CACHE_TTL=86400

# 各LLM供应商API配置
API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
AZURE_API_KEY=
AZURE_API_URL=
SONICA_API_KEY=
OLLAMA_API_URL=http://localhost:11434

##################################################
# RAG配置
##################################################

RAG_DEFAULT_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_DIR=./rag
RAG_INDEX_NAME=default_index
DEFAULT_QUERY_MODE=hybrid
DEFAULT_STREAM=false

##################################################
# 聊天会话配置
##################################################

MAX_HISTORY_MESSAGES=5
SESSION_TIMEOUT=3600

##################################################
# 安全设置
##################################################

# JWT相关配置
SECRET_KEY=change-me-jwt-secret-at-least-32-characters
# 默认使用环境变量密钥，避免把私钥打包进镜像；生产环境必须替换此值
JWT_ALGORITHM=HS256
# 服务间认证令牌
SERVICE_AUTH_TOKEN=change-me-internal-service-token
# 如需RS256，请在部署时挂载密钥并通过以下变量指定，切勿提交私钥
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key.pem
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem
# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 开发环境可设为true跳过令牌验证，生产环境必须设为false

##################################################
# 告警配置（可选）
##################################################

## SMTP邮件告警配置
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# ALERT_EMAIL=your-email@gmail.com
# ALERT_EMAIL_PASSWORD=your-app-password
# ALERT_RECEIVER_EMAIL=receiver@example.com

## 钉钉告警配置
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your-token
# DINGTALK_SECRET=your-secret

## 微信告警配置
# WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# 上传后等待文本提取完成，再导入知识库（秒）
RAG_FILE_READY_TIMEOUT=300
# 文本层 PDF 默认无需 LLM OCR 清理；仅需强制改写时启用
LLM_POST_PROCESS_TEXT_PDF=false
